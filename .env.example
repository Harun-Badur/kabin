# Kabin — kopyala: cp .env.example .env
# Gerçek anahtarları buraya yazma; yalnızca placeholder kullan.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_AFFILIATE_TAGS_JSON={"amazon":"","trendyol":"","hepsiburada":""}

# Sanal deneme (FASHN Try-On Max) Edge Function adresi.
# FASHN_API_KEY uygulamaya GİRMEZ; yalnızca Supabase secret olarak yazılır:
#   npx supabase secrets set FASHN_API_KEY=<key>
# Edge override (opsiyonel, default düşük maliyet):
#   FASHN_RESOLUTION=1k
#   FASHN_GENERATION_MODE=fast
#   FASHN_PROMPT=   # boş bırakılırsa prompt gönderilmez; set edilmezse default identity prompt
EXPO_PUBLIC_VTON_PROXY_URL=https://YOUR_PROJECT.functions.supabase.co/vton-proxy

# Öneri feedi (boşsa VTON URL'sinden /recs-feed türetilir).
EXPO_PUBLIC_RECS_FEED_URL=https://YOUR_PROJECT.functions.supabase.co/recs-feed

# Boş bırakılırsa Sentry hiç init edilmez (Expo Go uyumu).
# DSN: sentry.io → Create project → React Native → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Yalnızca lokal scriptler (import/seed). Uygulama koduna koyma; EXPO_PUBLIC_ prefix'i olmasın.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AFFILIATE_TAGS_JSON={"amazon":"","trendyol":"","hepsiburada":""}
